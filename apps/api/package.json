    "@ai-pm/project-state": "workspace:*",
    "@ai-pm/shared": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
