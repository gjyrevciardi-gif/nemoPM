# Path to the SQLite database file (created automatically on first run)
DATABASE_PATH=./data/ai-pm.db

# Google Gemini, free tier -- https://aistudio.google.com/apikey (no card needed).
# Speaks the OpenAI chat-completions format through this compat endpoint, tool
# calls included. Leave blank to run entirely on Ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Ollama local API (https://ollama.com). Used whenever GEMINI_API_KEY is blank.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Any model you have pulled locally, e.g. "llama3.1", "qwen2.5", "mistral"
OLLAMA_MODEL=

# How long to wait for one model call, in milliseconds. Raise it on slower
# hardware -- on a 2GB-VRAM laptop a single agent turn can take over a minute.
OLLAMA_TIMEOUT_MS=120000

# API server port
API_PORT=43821
